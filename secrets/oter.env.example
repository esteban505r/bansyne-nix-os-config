# Copy this file to oter.env in the same directory (oter.env is gitignored).
# Waybar loads secrets/oter.env before starting; waybar-oter-daemon sources the same file on launch.
#
# OTTER_API_TOKEN=your-jwt-here
# OTTER_BASE_URL=http://127.0.0.1:8080
# OTTER_WS_URL=ws://127.0.0.1:8080
# WAYBAR_SIGNAL=8
# OTTER_WAYBAR_TIMER_REFRESH_MS=1000
# OTTER_WAYBAR_STATE_FILE=/run/user/$UID/oter-waybar-state.json
# OTTER_WAYBAR_PERIODIC_FULL_REFRESH_SEC=60
# OTTER_WAYBAR_DEBUG=1
# OTTER_WAYBAR_LOG_FILE=/run/user/$UID/oter-waybar-daemon.log
# OTTER_WAYBAR_BAR_CLOCK=1
# Dashboard ?dateTime= is sent as dd/MM/yyyy HH:mm (required by the API). Optional seconds (only if your server accepts it):
# OTTER_DASHBOARD_TIME_WITH_SECONDS=1
#
# Logs include dashboard_digest (task/habit ids and names). If digest never changes after you complete a task in the app, the API is still returning the same dashboard — not a Waybar-only issue.

OTTER_API_TOKEN=
OTTER_BASE_URL=http://127.0.0.1:8080
